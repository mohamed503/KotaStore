# قيم وهمية فقط. لا تضع أسرارًا حقيقية هنا. الأسرار الحقيقية تُضبط في بيئة الاستضافة/GitHub Secrets.
# Dummy values only. Never commit real secrets.

APP_BASE_URL=https://example.invalid
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME   # placeholder
AUTH_SECRET=__SET_IN_ENVIRONMENT__

# تخزين الصور والنسخ (R2) — يُحدَّد بعد تجربة الجدوى
R2_ACCOUNT_ID=__SET_IN_ENVIRONMENT__
R2_ACCESS_KEY_ID=__SET_IN_ENVIRONMENT__
R2_SECRET_ACCESS_KEY=__SET_IN_ENVIRONMENT__
R2_BUCKET_IMAGES=__SET_IN_ENVIRONMENT__
R2_BUCKET_BACKUPS=__SET_IN_ENVIRONMENT__

# النسخ الاحتياطي: المفتاح العام فقط في CI؛ المفتاح الخاص يحتفظ به المالك خارج النظام
BACKUP_ENCRYPTION_PUBLIC_KEY=__PUBLIC_KEY_ONLY__

# إشعارات الموظفين (ADR-0025)
TELEGRAM_BOT_TOKEN=__SET_IN_ENVIRONMENT__
TELEGRAM_CHAT_ID=__SET_IN_ENVIRONMENT__

# مراقبة الأخطاء (ADR-0027)
SENTRY_DSN=__SET_IN_ENVIRONMENT__

# واتساب Cloud API — مؤجَّل (المرحلة 13)
WHATSAPP_APP_SECRET=__LATER__
WHATSAPP_VERIFY_TOKEN=__LATER__
